// Cloudflare Workers (static assets) hosting for station.bytheirfruit.church.
// Workers Builds runs `npm run build` (Vite, to dist/) and then
// `npx wrangler deploy`; the dashboard Worker name must match "name".
// Every path falls back to index.html (a single-page app).
{
  "name": "bytheirfruit-station",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
